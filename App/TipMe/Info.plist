<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- These six keys used to be filled in automatically by Xcode even when
	     absent from a static Info.plist. Newer Xcode (27) no longer does
	     that silently, and leaving them out produces a bundle with no
	     CFBundleIdentifier at all, which fails to install. Spelled out
	     explicitly so this does not depend on a given toolchain's
	     auto-fill behaviour. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleDisplayName</key>
	<string>TipMe</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>UILaunchScreen</key>
	<dict/>

	<!-- Portrait-only: a wallet confirm screen mid-rotation is exactly the
	     kind of thing that should never happen. Also required explicitly on
	     newer Xcode/iOS SDKs, which reject a build with no orientation list
	     at all rather than defaulting to one. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<key>NSFaceIDUsageDescription</key>
	<string>TipMe uses Face ID to confirm every payment before it is sent.</string>

	<!-- ASWebAuthenticationSession's callbackURLScheme for "Connect Instagram /
	     TikTok" (CreatorSetupView -> SocialAccountConnector). The registry's
	     own /v1/oauth/{platform}/callback redirects here once a sign-in
	     completes; must match TIPME_APP_URL_SCHEME on the registry. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>technology.tipme.app.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tipme</string>
			</array>
		</dict>
	</array>

	<!-- Populated from Config/Secrets.xcconfig; see .env.example and README. -->
	<key>TIPME_REGISTRY_BASE_URL</key>
	<string>$(TIPME_REGISTRY_BASE_URL)</string>
	<key>TIPME_REGISTRY_PUBLIC_KEY</key>
	<string>$(TIPME_REGISTRY_PUBLIC_KEY)</string>
	<key>TIPME_FEE_LIGHTNING_ADDRESS</key>
	<string>$(TIPME_FEE_LIGHTNING_ADDRESS)</string>
	<key>TIPME_FEE_BASIS_POINTS</key>
	<string>$(TIPME_FEE_BASIS_POINTS)</string>
	<key>TIPME_CAP_PER_TIP_GBP_PENCE</key>
	<string>$(TIPME_CAP_PER_TIP_GBP_PENCE)</string>
	<key>TIPME_CAP_PER_DAY_GBP_PENCE</key>
	<string>$(TIPME_CAP_PER_DAY_GBP_PENCE)</string>
	<key>TIPME_CAP_PER_WEEK_GBP_PENCE</key>
	<string>$(TIPME_CAP_PER_WEEK_GBP_PENCE)</string>
	<key>TIPME_RATELIMIT_SAME_HANDLE_COUNT</key>
	<string>$(TIPME_RATELIMIT_SAME_HANDLE_COUNT)</string>
	<key>TIPME_RATELIMIT_SAME_HANDLE_WINDOW_S</key>
	<string>$(TIPME_RATELIMIT_SAME_HANDLE_WINDOW_S)</string>
	<key>TIPME_RATELIMIT_GLOBAL_COUNT</key>
	<string>$(TIPME_RATELIMIT_GLOBAL_COUNT)</string>
	<key>TIPME_RATELIMIT_GLOBAL_WINDOW_S</key>
	<string>$(TIPME_RATELIMIT_GLOBAL_WINDOW_S)</string>
	<key>TIPME_APP_GROUP</key>
	<string>$(TIPME_APP_GROUP)</string>
	<key>TIPME_KEYCHAIN_ACCESS_GROUP</key>
	<string>$(TIPME_KEYCHAIN_ACCESS_GROUP)</string>
</dict>
</plist>
