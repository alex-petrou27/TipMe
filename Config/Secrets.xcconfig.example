// Generated from .env by Scripts/make-xcconfig.sh — do not edit by hand,
// and do not commit the generated Secrets.xcconfig.
//
// Note: xcconfig treats "//" as a comment, which breaks URLs. The generator
// escapes them as $(SLASH)$(SLASH); the definition below is what makes that
// work.
SLASH = /

TIPME_REGISTRY_BASE_URL = https:$(SLASH)$(SLASH)registry.tipme.example
TIPME_REGISTRY_PUBLIC_KEY =
TIPME_FEE_LIGHTNING_ADDRESS = fees@tipme.example
TIPME_FEE_BASIS_POINTS = 300
TIPME_CAP_PER_TIP_GBP_PENCE = 2000
TIPME_CAP_PER_DAY_GBP_PENCE = 10000
TIPME_CAP_PER_WEEK_GBP_PENCE = 30000
TIPME_RATELIMIT_SAME_HANDLE_COUNT = 3
TIPME_RATELIMIT_SAME_HANDLE_WINDOW_S = 600
TIPME_RATELIMIT_GLOBAL_COUNT = 20
TIPME_RATELIMIT_GLOBAL_WINDOW_S = 3600
TIPME_APP_GROUP = group.technology.tipme
TIPME_KEYCHAIN_ACCESS_GROUP = TEAMID.technology.tipme.shared
