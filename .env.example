# ---------------------------------------------------------------------------
# TipMe — copy to .env and fill in. NEVER commit the filled-in copy.
# iOS reads these via Config/Secrets.xcconfig (see README "Local dev setup").
# ---------------------------------------------------------------------------

# --- TipMe creator registry ----------------------------------------------
# Resolves a TikTok/Instagram handle to the creator's registered wallet.
TIPME_REGISTRY_BASE_URL=https://registry.tipme.example
# Public key (base64, Ed25519) used to verify signed registry responses, so a
# hostile registry or a MITM cannot redirect a tip to an attacker's wallet.
TIPME_REGISTRY_PUBLIC_KEY=

# --- Where our sender-side fee is collected ------------------------------
# A Lightning address we control. The creator is NEVER charged.
TIPME_FEE_LIGHTNING_ADDRESS=fees@tipme.example
# Basis points added on top of the tip. 300 = 3.00%. See FeePolicy.swift.
TIPME_FEE_BASIS_POINTS=300
# Display currency for tips and the currency the send caps are denominated in.
TIPME_FIAT_CURRENCY=GBP

# --- Hard security gates (enforced in TipMeCore, not in the UI) ----------
TIPME_CAP_PER_TIP_GBP_PENCE=2000        # £20.00 single tip ceiling
TIPME_CAP_PER_DAY_GBP_PENCE=10000       # £100.00 rolling 24h
TIPME_CAP_PER_WEEK_GBP_PENCE=30000      # £300.00 rolling 7d
TIPME_RATELIMIT_SAME_HANDLE_COUNT=3     # max tips to one handle...
TIPME_RATELIMIT_SAME_HANDLE_WINDOW_S=600  # ...per 10 minutes
TIPME_RATELIMIT_GLOBAL_COUNT=20         # max tips overall...
TIPME_RATELIMIT_GLOBAL_WINDOW_S=3600    # ...per hour

# --- iOS app group / keychain sharing ------------------------------------
# The app and the share extension must share these so the extension can reach
# the signed-in session and the audit log. Must match the entitlements.
TIPME_APP_GROUP=group.example.tipme
TIPME_KEYCHAIN_ACCESS_GROUP=TEAMID.example.tipme.shared

# --- Registry service (server-side only; never shipped in the app) -------
# Scripts/make-xcconfig.sh strips every REGISTRY_* key, so these cannot leak
# into the app bundle.
REGISTRY_DATABASE_PATH=./tipme_registry.sqlite3
# Private half of the pair from `python -m tipme_registry.keygen`. The public
# half goes in TIPME_REGISTRY_PUBLIC_KEY above.
REGISTRY_SIGNING_PRIVATE_KEY=
# Required for the verify and delete endpoints.
REGISTRY_ADMIN_TOKEN=
# New handle claims allowed per client per hour. Throttles handle-squatting.
REGISTRY_REGISTRATIONS_PER_HOUR=10
# New accounts allowed per client per hour. Separate from the handle-claim
# limit above -- opening a money-holding account is a different kind of
# abuse to defend against than squatting a creator handle.
REGISTRY_SIGNUPS_PER_HOUR=10
# Login attempts allowed per client per hour. A custodial account is only as
# safe as its password, so brute-forcing one has to be slow.
REGISTRY_LOGIN_ATTEMPTS_PER_HOUR=20

# --- Real Lightning deposits/withdrawals ---------------------------------
# Voltage's Payments API (voltage.cloud), credit-backed wallet. Until all
# four of these are set, /v1/deposit/lightning and /v1/withdraw/lightning
# fail closed with a 503 -- see lightning_node.py.
#   REGISTRY_VOLTAGE_API_KEY           from the dashboard's "API Keys" page
#   REGISTRY_VOLTAGE_ORGANIZATION_ID   your Voltage organization's id
#   REGISTRY_VOLTAGE_ENVIRONMENT_ID    the environment's UUID (not its label
#                                       like "production" -- Voltage rejects
#                                       that with a UUID-parsing error)
#   REGISTRY_VOLTAGE_WALLET_ID         the specific wallet's id ("Configure
#                                       Wallet" on its dashboard card)
#   REGISTRY_VOLTAGE_LINE_OF_CREDIT_ID `line_of_credit_id` from that same
#                                       wallet's `GET .../wallets/{id}`
#                                       response -- required by quoting and
#                                       sending, not just the wallet id
#   REGISTRY_VOLTAGE_NETWORK           `network` from that same wallet
#                                       response, e.g. "mutinynet"
# REGISTRY_-prefixed like everything else server-side above: make-xcconfig.sh
# strips this prefix from what reaches the app bundle, and a Lightning API
# key shipped inside the iOS binary would let anyone who decompiles the app
# move money out of it.
REGISTRY_VOLTAGE_API_KEY=
REGISTRY_VOLTAGE_ORGANIZATION_ID=
REGISTRY_VOLTAGE_ENVIRONMENT_ID=
REGISTRY_VOLTAGE_WALLET_ID=
REGISTRY_VOLTAGE_LINE_OF_CREDIT_ID=
REGISTRY_VOLTAGE_NETWORK=
